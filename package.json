{
  "name": "@stability-nexus/walletlink",
  "version": "0.1.0",
  "description": "A small, SaaS-free library to connect frontends to EVM wallets using EIP-1193 + EIP-6963 (no WalletConnect relay, no projectId).",
  "author": "The Stable Order",
  "license": "GPL-3.0-or-later WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/StabilityNexus/WalletLink.git"
  },
  "keywords": [
    "ethereum",
    "evm",
    "wallet",
    "eip-1193",
    "eip-6963",
    "wagmi",
    "viem"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:write": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "viem": "^2",
    "wagmi": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  }
}
